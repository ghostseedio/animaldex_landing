/**
 * The behaviour flows' species parameters (docs/ark/behaviour-flows.md section 4), from the stored data only:
 * data/ark/behaviour-profiles.json (diet, diets, the diet sentence, size, activity, social, roost, behaviours),
 * data/ark/behaviour-recipes.json (recipes and their behaviours' phrases), data/ark/hunt-acts.json (the hunt act) and
 * data/ark/hunt-tactics.json (the hunt style), data/ark/ambient-foods.json (the engine's background food). Deterministic rules, no model calls. Each value keeps its source.
 *
 *   npx tsx scripts/ark-flow-params.mts [--only slug,slug] [--out path]
 *
 * Writes src/ark-scene/flows/flow-params.json (pilot: the pilot kinds only, unless --all) and prints the guild counts.
 */

import {readFileSync, writeFileSync} from "node:fs";
import path from "node:path";
import {buildFlowParams, PILOT_SLUGS, type FlowSources} from "../src/ark-scene/flows/params";

const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..");
const read = (file: string) => JSON.parse(readFileSync(path.join(root, file), "utf8"));
const args = process.argv.slice(2);
const all = args.includes("--all");
const onlyArg = args[args.indexOf("--only") + 1];
const only = args.includes("--only") && onlyArg ? onlyArg.split(",") : all ? null : PILOT_SLUGS;
const out = args.includes("--out") ? args[args.indexOf("--out") + 1] : path.join(root, "src/ark-scene/flows/flow-params.json");

const sources: FlowSources = {
    profiles: read("data/ark/behaviour-profiles.json").profiles,
    recipes: read("data/ark/behaviour-recipes.json").species,
    acts: read("data/ark/hunt-acts.json").acts,
    tactics: read("data/ark/hunt-tactics.json").species,
    ambient: read("data/ark/ambient-foods.json").foods
};
const table = buildFlowParams(sources, only);
const counts: Record<string, number> = {};
for (const p of Object.values(table)) counts[p.guild] = (counts[p.guild] ?? 0) + 1;
writeFileSync(out, `${JSON.stringify({about: "Behaviour flow parameters (docs/ark/behaviour-flows.md section 4), generated by scripts/ark-flow-params.mts from data/ark: deterministic rules, no model calls. src: the stored field and phrase each value came from.", species: table}, null, 1)}\n`);
console.log(`${Object.keys(table).length} species → ${path.relative(root, out)}`);
console.log(counts);
