/**
 * p5 (monkeys): how each tree-living kind travels through the crowns, from its own stored text (the signature
 * behaviours catalogue, AnimalDex `docs/ark/signature-behaviours.json`: each row's `quote` is an exact span of the
 * species' stored text). Writes `src/ark-scene/canopy-moves.json` = {species: {<slug>: [mode, tail, quote]}}:
 *   brachiate  it swings arm over arm (brachiates, arm-swings)
 *   leap       it leaps or bounds between branches or trees (not a leap into water, not a bound on the ground)
 *   run        it runs along branches (and does not swing)
 *   tail       (with any mode) a prehensile tail grips branches
 * Only kinds whose behaviour profile climbs (`behaviours.json`), so a deer's "bounds between trees" never counts.
 *
 *   npx tsx scripts/ark-canopy-moves.mts <signature-behaviours.json>
 */
import {readFileSync, writeFileSync} from "node:fs";
import path from "node:path";

const source = process.argv[2];
if (!source) throw new Error("usage: ark-canopy-moves.mts <signature-behaviours.json>");
const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..");
const rows = (JSON.parse(readFileSync(source, "utf8")) as {rows: Array<{name: string; behaviour: string; quote: string}>}).rows;
const profiles = (JSON.parse(readFileSync(path.join(root, "src/ark-scene/behaviours.json"), "utf8")) as {species: Record<string, string>}).species;
const slugOf = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const climbs = (slug: string) => {
    const row = profiles[slug];
    if (!row) return false;
    const [move, moves] = row.split("|");
    return move === "climb" || moves.split(",").includes("climb");
};

const RULES: Array<[string, RegExp]> = [
    ["brachiate", /brachiat|arm[- ]over[- ]arm|arm-swing|swinging (movement|through)|long-arm swinging/i],
    ["leap", /(leap|bound)s?\b[^.]{0,40}\b(between|through|across|from one)\b[^.]{0,30}\b(branch|tree|canopy|crown|gap)|canopy (leap|gap)|bounding leaps/i],
    ["run", /runs? along branches/i]
];
const NEVER_SWINGS = /does not swing|never swings/i;
const TAIL = /prehensile tail|tail (curled|wrapped) (around|round) branch/i;
const found: Record<string, [string, number, string]> = {};
const tails = new Map<string, string>();
for (const row of rows) {
    const slug = slugOf(row.name);
    if (!climbs(slug)) continue;
    const text = `${row.behaviour} || ${row.quote}`;
    if (TAIL.test(text)) tails.set(slug, row.quote);
    for (const [mode, re] of RULES) {
        if (!re.test(text)) continue;
        if (mode === "brachiate" && NEVER_SWINGS.test(text)) continue;
        const had = found[slug];
        // The stronger way wins where a kind has more than one (brachiate over leap over run).
        const rank = (m: string) => ["run", "leap", "brachiate"].indexOf(m);
        if (!had || rank(mode) > rank(had[0])) found[slug] = [mode, 0, row.quote];
    }
}
for (const [slug, quote] of tails) {
    if (found[slug]) found[slug][1] = 1;
    else found[slug] = ["run", 1, quote];
}
const species = Object.fromEntries(Object.entries(found).sort(([a], [b]) => a.localeCompare(b)));
writeFileSync(path.join(root, "src/ark-scene/canopy-moves.json"), JSON.stringify({about: "Generated by scripts/ark-canopy-moves.mts from the signature behaviours catalogue (each quote an exact span of the species' stored text). species: {slug: [mode (brachiate | leap | run), 1 when a prehensile tail grips branches, the deciding quote]}. Only kinds whose behaviour profile climbs.", species}, null, 1) + "\n");
console.log(Object.entries(species).map(([s, v]) => `${s}: ${v[0]}${v[1] ? " +tail" : ""}  "${v[2].slice(0, 90)}"`).join("\n"));
