#!/usr/bin/env -S npx tsx
/**
 * Behaviour recipes for every Ark species, from stored data (the rich-behaviours brief:
 * docs/ark/behaviour-data-report.md and docs/ark/behaviour-recipes.md). Visual only: the
 * server's ecology decides every meal, birth and death; recipes only decide what an animal
 * is seen doing.
 *
 * Deterministic phrase rules over read-only exports (no AI calls), see `ark-behaviour-load.mts`
 * for the inputs and their queries, and `ark-behaviour-text.mts` for the rules.
 *
 *   npx tsx scripts/ark-behaviour-recipes.mts species.json extra.json intel.json [--summary summary.json]
 *
 * Outputs:
 *   - data/ark/behaviour-recipes.json: per species, every behaviour found with its stored field and verbatim
 *     phrase, its sex (system, share of males, size and look), its seasons, its nest, and its recipes;
 *   - src/ark-scene/recipes.json: the compact rows the scene reads (`behaviour-recipes.ts` decodes them);
 *   - with --summary, the coverage numbers for the report.
 */

import fs from "node:fs";
import path from "node:path";
import {loadSpecies} from "./ark-behaviour-load.mts";
import {behavioursOf, FIELD_SOURCES, nestOf, RULES, seasonOf, sexOf, sentences, type Hit, type TextField} from "./ark-behaviour-text.mts";
import {composeRecipes, compactRow, validateRecipes, RECIPE_VERSION, type Composed} from "./ark-behaviour-compose.mts";

const args = process.argv.slice(2);
const summaryAt = args.indexOf("--summary");
const summaryPath = summaryAt >= 0 ? args[summaryAt + 1] : null;
const reviewAt = args.indexOf("--review");
const reviewPath = reviewAt >= 0 ? args[reviewAt + 1] : null;
const [speciesPath, extraPath, intelPath] = args.filter((a, i) => !a.startsWith("--") && (summaryAt < 0 || i !== summaryAt + 1) && (reviewAt < 0 || i !== reviewAt + 1));
if (!speciesPath || !extraPath || !intelPath) {
    console.error("usage: ark-behaviour-recipes.mts species.json extra.json intel.json [--summary out.json]");
    process.exit(1);
}
const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..");
const species = loadSpecies(speciesPath, extraPath, intelPath, root);
const live = species.filter((s) => !s.excluded);

type Entry = {
    slug: string;
    name: string;
    plan: string;
    zone: string | null;
    excluded: string | null;
    behaviours: Record<string, Hit[]>;
    sex: ReturnType<typeof sexOf>;
    mating: ReturnType<typeof seasonOf>;
    nesting: ReturnType<typeof seasonOf>;
    nest: ReturnType<typeof nestOf>;
    recipes: Composed["recipes"];
    defaults: string[];
    crossing: Composed["crossing"];
    posture: Composed["posture"];
    hovers: boolean;
    nestingMonths: number[];
    nestingSrc: Composed["nestingSrc"];
    composed: Composed;
};

const entries: Entry[] = species.map((s) => {
    const behaviours = behavioursOf(s);
    const sex = sexOf(s);
    const mating = seasonOf(s, "mating");
    const nesting = seasonOf(s, "nesting");
    const nest = nestOf(s, behaviours.nest_build ?? []);
    const composed = composeRecipes(s, behaviours, {sex, mating, nesting, nest});
    return {
        slug: s.slug,
        name: s.name,
        plan: s.plan,
        zone: s.zone,
        excluded: s.excluded,
        behaviours,
        sex,
        mating,
        nesting,
        nest,
        recipes: composed.recipes,
        defaults: composed.defaults,
        crossing: composed.crossing,
        posture: composed.posture,
        hovers: composed.hovers,
        nestingMonths: composed.nesting,
        nestingSrc: composed.nestingSrc,
        composed
    };
});
// Validated against the engine: every recipe a template, every step a block, every crossing and posture known.
const errors = entries.flatMap((e) => validateRecipes(e.slug, e.composed));
if (errors.length) {
    console.error(`invalid recipes:\n${errors.slice(0, 30).join("\n")}`);
    process.exit(1);
}

const full = {
    about: "Generated by scripts/ark-behaviour-recipes.mts from read-only exports of the live catalogue (field guide, Power biology, System Dynamics, voyage traits). Deterministic phrase rules, no AI calls. behaviours: per behaviour, up to three {field, phrase, match}: the stored field and a verbatim phrase from it. recipes: the engine's recipes (behaviour-recipes.ts) each with its source ({field, phrase} from a behaviour, {rule} from the body plan or taxonomy, or {default}: no data, a body-plan default, flagged). Visual only.",
    version: RECIPE_VERSION,
    fields: FIELD_SOURCES,
    rules: Object.fromEntries(RULES.map((r) => [r.id, r.label])),
    species: entries.map(({composed: _composed, ...rest}) => rest)
};
fs.writeFileSync(path.join(root, "data/ark/behaviour-recipes.json"), JSON.stringify(full, null, 1) + "\n");
const compact: Record<string, string> = {};
for (const e of entries) if (!e.excluded) compact[e.slug] = compactRow(e.composed, e.sex, e.mating, e.nest);
fs.writeFileSync(
    path.join(root, "src/ark-scene/recipes.json"),
    JSON.stringify({about: "Generated by scripts/ark-behaviour-recipes.mts (full recipes with source phrases: data/ark/behaviour-recipes.json). Decoded by behaviour-recipes.ts.", version: RECIPE_VERSION, species: compact}) + "\n"
);

// MARK: Summary

const liveEntries = entries.filter((e) => !e.excluded);
const fieldCoverage: Record<string, number> = {};
for (const s of live) for (const f of Object.keys(FIELD_SOURCES) as TextField[]) if (s.text[f]) fieldCoverage[f] = (fieldCoverage[f] ?? 0) + 1;
const fieldSentences: Record<string, number> = {};
for (const s of live) for (const f of Object.keys(FIELD_SOURCES) as TextField[]) fieldSentences[f] = (fieldSentences[f] ?? 0) + sentences(s.text[f]).length;
const perBehaviour: Record<string, {species: number; byPlan: Record<string, number>; byField: Record<string, number>}> = {};
for (const e of liveEntries) {
    for (const [b, hits] of Object.entries(e.behaviours)) {
        const row = (perBehaviour[b] ??= {species: 0, byPlan: {}, byField: {}});
        row.species++;
        row.byPlan[e.plan] = (row.byPlan[e.plan] ?? 0) + 1;
        row.byField[hits[0].field] = (row.byField[hits[0].field] ?? 0) + 1;
    }
}
const behaviourCounts = liveEntries.map((e) => Object.keys(e.behaviours).filter((b) => b !== "call").length);
const nothing = liveEntries.filter((e) => !Object.keys(e.behaviours).filter((b) => b !== "call").length);
const nothingByPlan: Record<string, number> = {};
for (const e of nothing) nothingByPlan[e.plan] = (nothingByPlan[e.plan] ?? 0) + 1;
const plans: Record<string, number> = {};
for (const e of liveEntries) plans[e.plan] = (plans[e.plan] ?? 0) + 1;
const recipeCounts: Record<string, {species: number; phrase: number; rule: number; default: number}> = {};
for (const e of liveEntries)
    for (const r of e.recipes) {
        const row = (recipeCounts[r.id] ??= {species: 0, phrase: 0, rule: 0, default: 0});
        row.species++;
        if ("phrase" in r.src) row.phrase++;
        else if ("rule" in r.src) row.rule++;
        else row.default++;
    }
const summary = {
    species: species.length,
    aboard: live.length,
    plans,
    fieldCoverage,
    fieldSentences,
    perBehaviour,
    median: behaviourCounts.sort((a, b) => a - b)[Math.floor(behaviourCounts.length / 2)],
    nothing: nothing.length,
    nothingByPlan,
    nothingSample: nothing.slice(0, 40).map((e) => e.slug),
    sex: {
        systems: liveEntries.reduce<Record<string, number>>((m, e) => ((m[e.sex.system] = (m[e.sex.system] ?? 0) + 1), m), {}),
        bigger: liveEntries.reduce<Record<string, number>>((m, e) => ((m[e.sex.bigger ?? "alike or unknown"] = (m[e.sex.bigger ?? "alike or unknown"] ?? 0) + 1), m), {}),
        features: liveEntries.filter((e) => e.sex.male.length || e.sex.female.length).length,
        duller: liveEntries.filter((e) => e.sex.duller).length,
        stated: liveEntries.filter((e) => !e.sex.defaulted).length,
        ratio: liveEntries.filter((e) => e.sex.maleShare !== 0.5).length
    },
    seasons: {
        mating: liveEntries.reduce<Record<string, number>>((m, e) => ((m[e.mating.kind] = (m[e.mating.kind] ?? 0) + 1), m), {}),
        nesting: liveEntries.reduce<Record<string, number>>((m, e) => ((m[e.nesting.kind] = (m[e.nesting.kind] ?? 0) + 1), m), {})
    },
    nests: {
        species: liveEntries.filter((e) => e.nest).length,
        kinds: liveEntries.reduce<Record<string, number>>((m, e) => (e.nest ? ((m[e.nest.kind] = (m[e.nest.kind] ?? 0) + 1), m) : m), {}),
        materials: liveEntries.reduce<Record<string, number>>((m, e) => {
            for (const x of e.nest?.materials ?? []) m[x] = (m[x] ?? 0) + 1;
            return m;
        }, {})
    },
    recipes: recipeCounts,
    defaulted: liveEntries.filter((e) => e.defaults.length && e.recipes.length === e.defaults.length).length,
    withRecipes: liveEntries.filter((e) => e.recipes.some((r) => !("default" in r.src))).length,
    crossings: liveEntries.reduce<Record<string, number>>((m, e) => ((m[`${e.crossing.entry}/${e.crossing.exit}/${e.crossing.after}`] = (m[`${e.crossing.entry}/${e.crossing.exit}/${e.crossing.after}`] ?? 0) + 1), m), {}),
    postures: liveEntries.reduce<Record<string, number>>((m, e) => ((m[e.posture?.value ?? "none"] = (m[e.posture?.value ?? "none"] ?? 0) + 1), m), {})
};
if (summaryPath) fs.writeFileSync(summaryPath, JSON.stringify(summary, null, 1));
console.log(`species ${species.length}, aboard ${live.length}; nothing but calls ${nothing.length}; median behaviours ${summary.median}`);
console.log(`recipes: ${Object.entries(recipeCounts).map(([k, v]) => `${k} ${v.species}`).join(", ")}`);

// MARK: The owner's review sample

/** 40 species: the brief's named behaviours first, then the body plans, sex systems and defaults-only species. */
const REVIEW = [
    "common-kingfisher", "osprey", "grey-heron", "northern-gannet", "brown-pelican", "mallard", "great-cormorant", "gentoo-penguin",
    "harbor-seal", "sea-otter", "grizzly-bear", "red-deer", "bighorn-sheep", "common-hippopotamus", "southern-elephant-seal", "green-anole",
    "european-starling", "canada-goose", "sandhill-crane", "black-billed-magpie", "barn-swallow", "loggerhead-sea-turtle", "saltwater-crocodile",
    "european-rabbit", "aardvark", "red-junglefowl", "domestic-pig", "red-fox", "eastern-gray-squirrel", "american-robin", "chimpanzee",
    "indian-peafowl", "western-honey-bee", "acorn-barnacle", "common-octopus", "atlantic-cod", "american-bullfrog", "red-kangaroo", "addax", "atlas-moth"
];
if (reviewPath) {
    const bySlug = new Map(entries.map((e) => [e.slug, e]));
    const picked = REVIEW.map((slug) => bySlug.get(slug)).filter((e): e is Entry => Boolean(e && !e.excluded));
    const quote = (t: string) => `"${t.replace(/\|/g, "/").replace(/\s+/g, " ")}"`;
    const source = (src: Composed["recipes"][number]["src"]) => ("phrase" in src ? `${quote(src.phrase)} (${src.field})` : "rule" in src ? `rule: ${src.rule}` : `**default**: ${src.default}`);
    const months = (m: number[]) => (m.length ? m.map((n) => ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][n - 1]).join(" ") : "none stored");
    const lines: string[] = [
        "# Behaviour recipes: review sample of 40 species",
        "",
        "For the owner. Generated by `scripts/ark-behaviour-recipes.mts --review` from `data/ark/behaviour-recipes.json`; every species' full list is there. Each recipe shows where it came from:",
        "- a stored phrase (quoted, with its field);",
        "- a taxon or body-plan rule;",
        "- a **default** (no data: the body plan's, flagged).",
        "",
        "The recipes are templates of building blocks (`src/ark-scene/recipe-templates.ts`); see `docs/ark/behaviour-recipes.md`.",
        `Missing from the sample (not aboard or excluded): ${REVIEW.filter((slug) => !picked.some((e) => e.slug === slug)).join(", ") || "none"}.`,
        ""
    ];
    for (const e of picked) {
        lines.push(`## ${e.name} (\`${e.slug}\`, ${e.plan})`, "");
        lines.push("| Recipe | Weight | Source |", "|---|---|---|");
        for (const r of e.recipes) lines.push(`| ${r.id} | ${r.weight} | ${source(r.src)} |`);
        if (!e.recipes.length) lines.push("| (none) | | |");
        lines.push("");
        const sex = e.sex;
        const features = [...sex.male.map((f) => `male ${f}`), ...sex.female.map((f) => `female ${f}`)].join(", ");
        const sexLine = sex.system === "separate" ? `${Math.round(sex.maleShare * 100)}% male; ${sex.bigger ? `${sex.bigger} bigger (×${sex.sizeRatio} length)` : "same size"}${sex.duller ? `; ${sex.duller} duller` : ""}${features ? `; ${features}` : ""}` : `${sex.system}${sex.maleShare ? ` (${Math.round(sex.maleShare * 100)}% male)` : ""}`;
        lines.push(`- **Sex:** ${sexLine}${sex.src[0] ? ` (${quote(sex.src[0].phrase)})` : " (default: nothing stored)"}`);
        lines.push(`- **Seasons:** mating ${months(e.mating.months)} (${e.mating.kind}); nesting ${months(e.nestingMonths)} (${e.nestingSrc ? source(e.nestingSrc as never) : e.nesting.kind})`);
        lines.push(`- **Water:** in by ${e.crossing.entry}, out by ${e.crossing.exit}, then ${e.crossing.after} (${source(e.crossing.src)})`);
        if (e.posture) lines.push(`- **Sleeps:** ${e.posture.value.replace("_", " ")} (${source(e.posture.src)})`);
        if (e.nest && e.recipes.some((r) => r.id === "nest_build")) lines.push(`- **Nest:** ${e.nest.kind}, ${e.nest.materials.join(", ") || "material not stored"}`);
        if (e.defaults.length) lines.push(`- **Flagged defaults:** ${e.defaults.join(", ")}`);
        lines.push("");
    }
    fs.writeFileSync(reviewPath, lines.join("\n"));
    console.log(`review: ${picked.length} species to ${reviewPath}`);
}
