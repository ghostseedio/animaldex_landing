#!/usr/bin/env -S npx tsx
/**
 * The countryside's resident table (p5 (rural), `src/ark-scene/islands/town/rural.ts` ruralKindOf): which kind of field
 * a kept animal lives in, by the genus of its record's scientific name. Livestock and poultry only; pets (dogs, cats,
 * rabbits, cage birds, pigeons) are not here and stay at home. The genera are taxonomy, not a list of animals:
 *
 * - cattle: Bos, Bubalus (the dairy's pasture; water buffalo graze with cattle);
 * - horses: Equus caballus/ferus; donkeys: Equus asinus/africanus (the genus is shared: the species decides);
 * - sheep: Ovis; camelids: Lama, Vicugna (kept with sheep, as alpacas guard flocks); goats: Capra; pigs: Sus;
 * - poultry: Gallus, Meleagris, Coturnix, Numida, Pavo; waterfowl: Anas, Anser, Cairina.
 *
 * With `--snapshot <file>` (a voyage read) it also lists the record's species of each kind that live at homes and farms
 * (`seen`, for reading by eye).
 *
 *   npx tsx scripts/ark-rural-residents.mts [--snapshot public/ark-local/snap.json]
 */
import {existsSync, readFileSync, writeFileSync} from "node:fs";
import path from "node:path";
import {fileURLToPath} from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
export const RURAL_GENERA: Record<string, string> = {
    Bos: "cattle", Bubalus: "cattle",
    Ovis: "sheep", Lama: "camelids", Vicugna: "camelids", Capra: "goats", Sus: "pigs",
    Gallus: "poultry", Meleagris: "poultry", Coturnix: "poultry", Numida: "poultry", Pavo: "poultry",
    Anas: "waterfowl", Anser: "waterfowl", Cairina: "waterfowl"
};
/** Equus by species (the second word): horses and donkeys keep their own paddocks. */
export const RURAL_EQUUS: Record<string, string> = {caballus: "horses", ferus: "horses", asinus: "donkeys", africanus: "donkeys"};

const out: {about: string; genera: Record<string, string>; equus: Record<string, string>; seen?: Record<string, string[]>} = {
    about: "Generated by scripts/ark-rural-residents.mts. A kept animal's field kind by its record's scientific name (genus; Equus by species). Pets are absent and stay at home (rural.ts ruralKindOf).",
    genera: RURAL_GENERA,
    equus: RURAL_EQUUS
};
const at = process.argv.indexOf("--snapshot");
const file = at > 0 ? process.argv[at + 1] : path.join(root, "public/ark-local/snap.json");
if (existsSync(file)) {
    const raw = JSON.parse(readFileSync(file, "utf8"));
    const animals = ((raw.snapshot ?? raw).animals ?? []) as Array<{model_slug: string; scientific_name?: string; area?: string}>;
    const seen: Record<string, Set<string>> = {};
    for (const a of animals) {
        if (a.area !== "house" && a.area !== "farm" && a.area !== "zoo") continue;
        const [g, s] = (a.scientific_name ?? "").split(/\s+/);
        const kind = g === "Equus" ? RURAL_EQUUS[(s ?? "").toLowerCase()] : RURAL_GENERA[g];
        if (kind) (seen[kind] ??= new Set()).add(a.model_slug);
    }
    out.seen = Object.fromEntries(Object.entries(seen).map(([k, v]) => [k, Array.from(v).sort()]));
}
writeFileSync(path.join(root, "src/ark-scene/islands/town/rural-residents.json"), JSON.stringify(out, null, 1) + "\n");
console.log(JSON.stringify(out.seen ?? {}));
