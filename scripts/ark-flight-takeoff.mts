#!/usr/bin/env -S npx tsx
/**
 * How each flying bird gets off the ground and back down (movement audit lane MA1, problem 3): which families need a
 * run across the water or along the ground to take off (swans, geese, coots, grebes, loons, auks, cormorants, pelicans,
 * flamingos, albatrosses; cranes, storks, bustards and the big vultures on land), and which ski to a stop on the water.
 * From the stored taxonomy only: the family each bird's flight style was decided by, in `data/ark/locomotion-styles.json`
 * (lane L2's reasons, written by `scripts/ark-locomotion-styles.mts` from the catalogue). Deterministic, no AI calls.
 *
 *   npx tsx scripts/ark-flight-takeoff.mts
 *
 * Output: `src/ark-scene/locomotion/takeoff.json` ({slug: class}), decoded by `locomotion/flight.ts` `takeoffClass`:
 *   w   runs across the water to take off (patters), skis in to land on it
 *   wg  runs on the water and on the ground
 *   g   runs along the ground (cranes, storks, bustards, New World vultures, ground hornbills)
 *   a   waterfowl (Anatidae, screamers, the magpie goose): by its mass, a swan or goose runs and a dabbling duck springs
 *       straight off; all of them ski in on the water
 *   h   a heavy raptor (Accipitridae): runs a few steps on the ground only when it is heavy (a vulture, a big eagle)
 * Every other flyer springs off and stops in the air before it touches down.
 */

import fs from "node:fs";
import path from "node:path";

const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..");
const reasons = JSON.parse(fs.readFileSync(path.join(root, "data/ark/locomotion-styles.json"), "utf8")) as {species: Record<string, {flight?: {code: string; why: string}}>};

/** Families by how they take off (Pennycuick 2008 "Modelling the flying bird" ch. 8; field guides' take-off accounts). */
const CLASS: Record<string, "w" | "wg" | "g" | "a" | "h"> = {
    // Run across the water (high wing loading, short wings, feet set far back).
    Rallidae: "w",
    Podicipedidae: "w",
    Gaviidae: "w",
    Alcidae: "w",
    Phalacrocoracidae: "w",
    Anhingidae: "w",
    Sulidae: "w",
    Procellariidae: "w",
    Hydrobatidae: "w",
    // Both.
    Pelecanidae: "wg",
    Phoenicopteridae: "wg",
    Diomedeidae: "wg",
    // On the ground.
    Gruidae: "g",
    Otididae: "g",
    Ciconiidae: "g",
    Cathartidae: "g",
    Bucorvidae: "g",
    Sagittariidae: "g",
    // By mass.
    Anatidae: "a",
    Anhimidae: "a",
    Anseranatidae: "a",
    Accipitridae: "h"
};

const out: Record<string, string> = {};
const tally: Record<string, number> = {};
for (const [slug, row] of Object.entries(reasons.species).sort(([a], [b]) => a.localeCompare(b))) {
    const why = row.flight?.why;
    if (!why) continue;
    const family = why.split(":")[0].trim();
    const cls = CLASS[family];
    if (!cls) continue;
    out[slug] = cls;
    tally[cls] = (tally[cls] ?? 0) + 1;
}
const file = path.join(root, "src/ark-scene/locomotion/takeoff.json");
fs.writeFileSync(
    file,
    `{"about":"Generated by scripts/ark-flight-takeoff.mts from the families in data/ark/locomotion-styles.json. w runs across the water to take off and skis in on it; wg on the water and the ground; g on the ground; a waterfowl, by mass (swans and geese run, dabbling ducks spring; all ski in); h a raptor that runs only when heavy. Decoded by locomotion/flight.ts takeoffClass.",\n"species":{\n${Object.entries(out).map(([slug, cls]) => `${JSON.stringify(slug)}:${JSON.stringify(cls)}`).join(",\n")}\n}}\n`
);
console.log(JSON.stringify(tally), `${Object.keys(out).length} species`);
