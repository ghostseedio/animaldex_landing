#!/usr/bin/env -S npx tsx
/**
 * The rig set's clip coverage for CI (movement audit MA4; docs/ark/movement-audit-2026-11-13.md, its CI table): per
 * species, its rig's body plan, whether its flight is approved or drawn open-winged, and which movement clips passed,
 * from a local publish set's `detail.json` (`publish_rig.py`; the same entries the rig files carry). Read-only; nothing is
 * uploaded. `src/lib/ark-rig-coverage.test.ts` reads it against the behaviour table: flyers with frozen wings, flyers
 * with no take-off or landing, species flying on the schedule without approval, swimmers with no stroke or no way into
 * the water.
 *
 *   npx tsx scripts/ark-rig-coverage.mts --set ~/animaldex-talking-models/rig/publish-v2 --version v2
 *
 * Writes `tests/ark-motion/rig-coverage-<version>.json`: {version, clips: [names], species: {slug: "plan|flags|bits"}}:
 * flags `a` flight approved, `o` open-winged fallback, `s` a sitting rest pose, `p` a partial rig; bits: one character
 * per name in `clips`, 1 when that clip passed (a partial rig's own failures are 0).
 */

import fs from "node:fs";
import os from "node:os";
import path from "node:path";

const arg = (name: string, fallback: string | null = null) => {
    const at = process.argv.indexOf(`--${name}`);
    return at > 0 && process.argv[at + 1] && !process.argv[at + 1].startsWith("--") ? process.argv[at + 1] : fallback;
};
const home = os.homedir();
const set = path.resolve((arg("set", path.join(home, "animaldex-talking-models/rig/publish-v2")) as string).replace(/^~/, home));
const version = arg("version", "v2")!;
const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..");
const CLIPS = ["flap", "glide", "soar", "hover", "takeoff", "land", "swim", "paddle", "dive", "enter_water", "exit_water", "walk", "run", "hop", "idle"] as const;

type Entry = {state?: string; plan?: string | null; pose?: string | null; flight_approved?: boolean; flight_fallback_open?: boolean; clips?: Record<string, {frames?: number; pass?: boolean}>};
const detail = JSON.parse(fs.readFileSync(path.join(set, "detail.json"), "utf8")) as {species: Record<string, Entry>};
const rows: Record<string, string> = {};
for (const [slug, e] of Object.entries(detail.species).sort(([a], [b]) => a.localeCompare(b))) {
    if (e.state !== "passed" && e.state !== "partial") continue;
    // (The rule every player reads, `rig-clips.ts` rigClip: listed with its frames and passing.)
    const has = (name: string) => Boolean(e.clips?.[name]?.frames && e.clips[name].pass !== false);
    const flags = `${e.flight_approved ? "a" : ""}${e.flight_fallback_open ? "o" : ""}${e.pose ? "s" : ""}${e.state === "partial" ? "p" : ""}`;
    rows[slug] = `${e.plan ?? ""}|${flags}|${CLIPS.map((c) => (has(c) ? "1" : "0")).join("")}`;
}
const out = path.join(root, "tests/ark-motion", `rig-coverage-${version}.json`);
fs.writeFileSync(
    out,
    `{"about":"Generated by scripts/ark-rig-coverage.mts from the ${version} rig set's detail.json: per species plan|flags|clips (flags: a flight approved, o open-winged fallback, s sitting rest pose, p partial; clips: one bit per name below, 1 = passed). Read by src/lib/ark-rig-coverage.test.ts.",\n"version":${JSON.stringify(version)},\n"clips":${JSON.stringify(CLIPS)},\n"species":{\n${Object.entries(rows).map(([s, r]) => `${JSON.stringify(s)}:${JSON.stringify(r)}`).join(",\n")}\n}}\n`
);
console.log(`${Object.keys(rows).length} species -> ${path.relative(root, out)}`);
