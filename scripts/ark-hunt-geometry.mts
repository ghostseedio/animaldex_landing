#!/usr/bin/env -S npx tsx
/**
 * Hunt geometry (lane HUNTGEO, AnimalDex decision 500; voyage_config.hunt_geometry, default off): each hunter's way of
 * hunting, as the shared position module lays out its foray (`positions/positions.ts` huntForayAt) and the engine finds
 * its prey (AnimalDex supabase/functions/_shared/ark-ecology/geometry.ts). Writes `src/ark-scene/positions/hunt-geometry.json`,
 * a byte-identical copy of which lives in AnimalDex supabase/functions/_shared/ark-positions/ (pinned in PIN.json).
 *
 * Inputs (nothing is looked up, nothing is generated by a model):
 *   - `src/ark-scene/hunt-acts.json`: the species' one hunt act (scripts/ark-hunt-acts.mts: its own catalogue text, its
 *     ambient hunting recipe or E5's hunt style);
 *   - AnimalDex `docs/ark/signature-behaviours.json` (`--catalogue <path>`): the catalogue rows of theme `hunt_tactic`
 *     whose tactic is `bait` (a lure that draws prey in: the alligator snapping turtle's tongue, a frogfish's rod, the
 *     orchid mantis's flower look), matched to the act table by the species' name.
 *
 * The classes, by act (the scene's own search styles, `hunt-search.ts`: creep, glean, soar and weave search; watch waits):
 *   search  pounce leap jump peck hover plunge talon stoop hawk: its foray works towards where its prey lives
 *   ambush  lunge lurk tongue web dash drop: it keeps to one spot and takes what comes within its strike reach
 *   (none)  wade, dive and no act: today's foray, unchanged
 * An ambusher whose catalogue row is a `bait` tactic is a lurer.
 *
 *   npx tsx scripts/ark-hunt-geometry.mts --catalogue ../AnimalDex/docs/ark/signature-behaviours.json [--dry]
 */
import fs from "node:fs";
import path from "node:path";

const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..");
const arg = (name: string) => {
    const at = process.argv.indexOf(`--${name}`);
    return at > 0 ? process.argv[at + 1] : undefined;
};

/** Class codes (positions.ts GEO_SEARCH, GEO_AMBUSH, GEO_LURE). */
const SEARCH = 1;
const AMBUSH = 2;
const LURE = 3;

/**
 * Per act: its class and, for an ambusher, its strike reach in its own body lengths (0: what it sees, its detection
 * range: a perch hunter drops on what moves below it). Ark estimates, each with its reason; the reach is floored and
 * capped by the engine (geometry.ts STRIKE_MIN, its detection range).
 */
const ACTS: Record<string, {cls: number; reach?: number; why: string}> = {
    pounce: {cls: SEARCH, why: "stalks through its range to prey it has found (cats, foxes)"},
    leap: {cls: SEARCH, why: "the same, a high arc (foxes, servals)"},
    jump: {cls: SEARCH, why: "jumping spiders hunt actively, walking up to prey they have seen"},
    peck: {cls: SEARCH, why: "a ground bird runs, stops and looks, working the ground"},
    hover: {cls: SEARCH, why: "quarters its range on the wing and hangs over prey"},
    plunge: {cls: SEARCH, why: "patrols over the water to where fish are"},
    talon: {cls: SEARCH, why: "a raptor sweeping its range"},
    stoop: {cls: SEARCH, why: "a falcon's search on the wing"},
    hawk: {cls: SEARCH, why: "quarters the air after flying prey (swallows, dragonflies, bee-eaters)"},
    lunge: {cls: AMBUSH, reach: 1, why: "waits still; a strike reaches about its own length (mantises, frogs, snapping turtles, caimans)"},
    lurk: {cls: AMBUSH, reach: 1, why: "a crocodilian lies still in the water; its lunge reaches about its length"},
    tongue: {cls: AMBUSH, reach: 1, why: "a toad waits; its tongue and a hop take prey about a length away"},
    web: {cls: AMBUSH, reach: 10, why: "a web spider waits at its web, many of its own lengths across"},
    dash: {cls: AMBUSH, reach: 3, why: "waits still, then a short dash of a few lengths (geckos, wall lizards, wolf and huntsman spiders)"},
    drop: {cls: AMBUSH, reach: 0, why: "a perch hunter waits on its perch and drops on prey it sees move below (owls, shrikes, kookaburras)"}
};

const acts = JSON.parse(fs.readFileSync(path.join(root, "src/ark-scene/hunt-acts.json"), "utf8")) as {species: Record<string, string>};
const full = JSON.parse(fs.readFileSync(path.join(root, "data/ark/hunt-acts.json"), "utf8")) as {acts: Array<{slug: string; name: string}>};
const catalogue = arg("catalogue");
if (!catalogue) throw new Error("--catalogue <AnimalDex docs/ark/signature-behaviours.json> is needed (the bait rows)");
const cat = JSON.parse(fs.readFileSync(path.resolve(catalogue), "utf8")) as {rows: Array<{name: string; theme?: string; tactic?: string; behaviour: string; source_field: string; quote: string}>};

const slugByName = new Map<string, string>();
for (const a of full.acts) slugByName.set(a.name.toLowerCase(), a.slug);

const lures: Array<{slug: string; name: string; behaviour: string; field: string; quote: string}> = [];
const lureSlugs = new Set<string>();
for (const r of cat.rows) {
    if (r.theme !== "hunt_tactic" || r.tactic !== "bait") continue;
    const slug = slugByName.get(r.name.toLowerCase());
    if (!slug) continue;
    const act = acts.species[slug];
    if (!act || ACTS[act]?.cls !== AMBUSH) continue;
    if (lureSlugs.has(slug)) continue;
    lureSlugs.add(slug);
    lures.push({slug, name: r.name, behaviour: r.behaviour, field: r.source_field, quote: r.quote});
}

const species: Record<string, number[]> = {};
const counts: Record<string, number> = {};
for (const slug of Object.keys(acts.species).sort()) {
    const act = acts.species[slug];
    const a = ACTS[act];
    if (!a) continue;
    const cls = a.cls === AMBUSH && lureSlugs.has(slug) ? LURE : a.cls;
    species[slug] = cls === SEARCH ? [cls] : [cls, a.reach ?? 0];
    counts[act] = (counts[act] ?? 0) + 1;
}

const out = {
    about: "Hunt geometry (AnimalDex decision 500, voyage_config.hunt_geometry): species (look slug) -> [class, strike reach in body lengths for an ambusher (0: its detection range)]. Class 1 searches towards its prey, 2 waits in ambush, 3 waits in ambush with a lure. Generated by scripts/ark-hunt-geometry.mts from src/ark-scene/hunt-acts.json and the catalogue's bait rows; byte-identical in AnimalDex supabase/functions/_shared/ark-positions/.",
    v: 1,
    acts: ACTS,
    lures,
    species
};
const text = JSON.stringify(out) + "\n";
console.log(JSON.stringify({species: Object.keys(species).length, counts, lures: lures.map((l) => l.slug)}));
if (!process.argv.includes("--dry")) fs.writeFileSync(path.join(root, "src/ark-scene/positions/hunt-geometry.json"), text);
