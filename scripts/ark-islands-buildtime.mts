// The town's build, step by step (main-thread cost on this machine): what to slice or move to a worker (decision 153).
const t = () => performance.now();
let a = t();
const {townPlan} = await import("@/ark-scene/islands/town/plan");
const plan = townPlan();
console.log("plan", Math.round(t() - a));
a = t();
const {groundGrid, buildTownIsland} = await import("@/ark-scene/islands/town/render/index");
groundGrid();
console.log("groundGrid", Math.round(t() - a));
a = t();
const {buildScenery} = await import("@/ark-scene/islands/town/render/scenery");
buildScenery(plan);
console.log("scenery", Math.round(t() - a));
a = t();
buildTownIsland({tier: "low"});
console.log("buildTownIsland (plan cached)", Math.round(t() - a));
a = t();
const {townAreas} = await import("@/ark-scene/islands/town/areas");
townAreas();
console.log("areas", Math.round(t() - a));
a = t();
const {townWorldSampler} = await import("@/ark-scene/islands/town/sampler");
const {launchEnclosures} = await import("@/ark-scene/islands/town/areas");
townWorldSampler(launchEnclosures(), {x: 500, z: -200});
console.log("sampler", Math.round(t() - a));
a = t();
const {townColliderSet} = await import("@/ark-scene/islands/town/colliders");
townColliderSet(launchEnclosures(), {x: 500, z: -200});
console.log("colliders", Math.round(t() - a));
