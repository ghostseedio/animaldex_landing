#!/usr/bin/env -S npx tsx
/**
 * Signature behaviours, the hunt tactics (AnimalDex docs/ark/behaviours-plan.md, theme `hunt_tactic`): which species
 * hunt in which way, for the scene's hunt acts (`src/ark-scene/hunt-acts.ts`). The scene plays an act only on a
 * released hunt record (a meal, an escape) and a hunter's released search; it never decides an outcome.
 *
 * Inputs (nothing is looked up, nothing is generated by a model):
 *   - `data/ark/hunt-tactics.json`: per species, the catalogue's hunt rows (what the species' own text says, with the
 *     stored field and the exact sentence) and the engine's hunt style (E5's lexicon over the same text, with the
 *     verbatim phrase);
 *   - `src/ark-scene/recipes.json`: the hunting recipe a species already has in the ambient layer (one way of hunting a
 *     species: a recipe the species already has decides its act's family, so the two never disagree or double).
 *
 * Order of evidence, first that applies: (1) the catalogue rows, read species by species (the table `HAND`: each entry
 * names the row's `uses` it follows); (2) the species' ambient hunting recipe by its body plan; (3) E5's hunt style by
 * its body plan. A species with none keeps the generic chase (stalk, sprint, lunge): nothing is guessed.
 *
 *   npx tsx scripts/ark-hunt-acts.mts [--summary] [--aboard <jsonl of {slug,n,island}>] [--dry]
 */
import fs from "node:fs";
import path from "node:path";

const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..");
const arg = (name: string) => {
    const at = process.argv.indexOf(`--${name}`);
    return at > 0 ? process.argv[at + 1] : undefined;
};

type Row = {uses: string; how: string; behaviour: string; field: string; quote: string};
type Species = {slug: string; name: string; plan: string | null; rows: Row[]; style: {style: string; field: string | null; phrase: string | null; source: string | null} | null};

/** The acts (`hunt-acts.ts` builds each): pounce (stalk, wiggle, leap), leap (the same, a high arc: foxes, servals), jump, dash (wait, then a short dash), lunge, tongue, web, wade, lurk, drop (from a perch), hover (then drop), plunge (onto water prey), talon (a raptor: plunge onto water prey, else the stoop), hawk (in the air after flying prey), peck (on the ground), dive (from the water's surface). */
export const ACTS = ["pounce", "leap", "jump", "dash", "lunge", "tongue", "web", "wade", "lurk", "drop", "hover", "plunge", "talon", "hawk", "peck", "dive", "stoop"] as const;
type Act = (typeof ACTS)[number];

/**
 * (1) The catalogue rows, read by hand (every `hunt_tactic` row of docs/ark/signature-behaviours.json, 2026-11-20). The
 * value names the row it follows. The generic chase keeps: snakes (a creep and a strike already), fish (the water chase),
 * the octopus, rays and sharks (their rows are effects the scene has no pose for), pack and herding rows (they need
 * more than two bodies: later).
 */
const HAND: Record<string, [Act, string]> = {
    // Stalk, a short wiggle, the leap.
    "domestic-cat": ["pounce", "crouched motionless wait then pounce"],
    "bengal-tiger": ["pounce", "pounce (stalk + ambush): patient lone stalk then explosive finish"],
    "sumatran-tiger": ["pounce", "pounce: gets very close undetected then sudden attack"],
    "indochinese-tiger": ["pounce", "pounce: silent stalk then short powerful attack"],
    "red-fox": ["leap", "clip:fox_mouse_pounce: high arcing pounce onto prey heard under grass/snow"],
    "serval": ["leap", "clip:serval_high_pounce: listens, then high pounce onto hidden rodents"],
    // Jumping spiders: stalk, pause, a dragline, a leap of many body lengths.
    "jumping-spider": ["jump", "pounce+prop:dragline"],
    "bold-jumper": ["jump", "pounce+prop:dragline"],
    "pantropical-jumping-spider": ["jump", "pounce: walks into range on a sunny wall, then jumps"],
    "peterss-jumping-spider": ["jump", "pounce+prop:dragline"],
    "two-striped-telamonia": ["jump", "pounce+prop:dragline"],
    // Motionless, then a short dash.
    "common-house-gecko": ["dash", "pounce (on wall, near light)"],
    "leopard-gecko": ["dash", "pounce (from burrow entrance)"],
    "common-wall-gecko": ["dash", "pounce (wall ambush near light)"],
    "mediterranean-house-gecko": ["dash", "pounce (wall ambush near light)"],
    "tropical-house-gecko": ["dash", "pounce (wall ambush near light)"],
    "oriental-garden-lizard": ["dash", "pounce (from perch): short rapid attack"],
    "brazilian-lava-lizard": ["dash", "pounce: motionless on rock then dashes out at insect"],
    "bocages-wall-lizard": ["dash", "pounce: dash from basking spot"],
    "carolina-wolf-spider": ["dash", "pounce: chases ground insects, pins them with front legs"],
    "tiger-wolf-spider": ["dash", "ambush: waits motionless, then runs prey down in a short dash"],
    "barn-funnel-weaver": ["dash", "ambush: sprints from tube, bites prey and drags it back"],
    "giant-house-spider": ["dash", "ambush: waits motionless in funnel, dashes out on vibration"],
    "house-centipede": ["dash", "gait:dash_stop_rush"],
    "woodlouse-hunter-spider": ["dash", "clip:woodlouse_pin_bite"],
    "red-kneed-tarantula": ["dash", "prop:burrow_entrance: sits at the entrance after dark"],
    // Waits, then the strike reaches out.
    "red-assassin-bug": ["lunge", "ambush: waits on stems to seize passing insects"],
    "minute-pirate-bug": ["lunge", "ambush: waits among flower parts and grabs prey that comes close"],
    "wheel-bug": ["lunge", "stalk+strike: strikes when prey comes in range"],
    "chinese-mantis": ["lunge", "ambush+strike: stands still and ambushes passing insects"],
    "stick-mantis": ["lunge", "ambush+strike: forelegs folded and still until prey comes within reach"],
    "orchid-mantis": ["lunge", "ambush+strike: waits on vegetation looking like a flower"],
    "giant-asian-mantis": ["lunge", "pose:leaf_sway: sways like a leaf while watching prey"],
    "flower-crab-spider": ["lunge", "clip:crab_spider_leg_clamp: waits on a flower with front legs open"],
    "american-bullfrog": ["lunge", "ambush: waits at the water edge to catch prey"],
    "common-snapping-turtle": ["lunge", "ambush+strike (from mud)"],
    "alligator-snapping-turtle": ["lunge", "clip:tongue_lure_gape: lies jaws-open wriggling a lure"],
    "chinese-giant-salamander": ["lunge", "ambush (from rock-den)"],
    "komodo-dragon": ["lunge", "ambush+strike: ambushes deer/pigs from concealment"],
    "american-toad": ["tongue", "strike + look:tongue_flick: flicks out a sticky tongue"],
    // Webs.
    "daddy-long-legs-spider": ["web", "clip:silk_throw_longlegs"],
    "common-house-spider": ["web", "clip:silk_fling_hindlegs"],
    "orb-weaver-spider": ["web", "prop:leaf_retreat+signal_thread"],
    "walnut-orb-weaver": ["web", "prop:web_orb+signal_thread+bark_retreat"],
    // Wading: slow placed steps, motionless, the spear.
    "great-egret": ["wade", "wade_spear"], "little-egret": ["wade", "clip:egret_canopy_dash"], "snowy-egret": ["wade", "clip:foot_stir"],
    "great-blue-heron": ["wade", "wade_spear"], "grey-heron": ["wade", "wade_spear"], "little-blue-heron": ["wade", "wade_spear"],
    "tricolored-heron": ["wade", "clip:egret_canopy_dash"], "chinese-pond-heron": ["wade", "wade_spear"], "javan-pond-heron": ["wade", "wade_spear"],
    "lesser-adjutant-stork": ["wade", "wade_spear"], "saddle-billed-stork": ["wade", "wade_spear"],
    // Crocodilians: submerged stillness, then an explosive strike.
    "saltwater-crocodile": ["lurk", "ambush+strike: log-like submerged waiting then explosive strike"],
    "american-alligator": ["lurk", "ambush+strike / pose:eyes_above_water"],
    "american-crocodile": ["lurk", "bask_sun + ambush / pose:eyes_above_water"],
    "mugger-crocodile": ["lurk", "ambush+strike: ambush at drinking spots then sudden lunge"],
    "siamese-crocodile": ["lurk", "ambush+strike: submerged stillness then sudden lunge"],
    "spectacled-caiman": ["lurk", "clip:caiman_side_snap: drifts with eyes and nostrils above water"],
    // From a perch onto prey on the ground.
    "laughing-kookaburra": ["drop", "pounce: perches still then swoops to pounce on ground prey"],
    "roadside-hawk": ["drop", "pounce: drops from a low post onto prey and flies back up"],
    "little-owl": ["drop", "pounce: watches from a fence post, glides down onto voles and beetles"],
    "spotted-wood-owl": ["drop", "pounce: perches motionless listening, then a short silent descent"],
    "brown-wood-owl": ["drop", "pounce: perches silently then swoops down"],
    "eurasian-eagle-owl": ["drop", "pounce: silent approach and powerful talon strike"],
    "crested-serpent-eagle": ["drop", "pounce: watches the floor from a shaded perch, drops on snakes"],
    "racket-tailed-roller": ["drop", "pounce: watches from a perch then drops to seize prey on the ground"],
    "brown-shrike": ["drop", "pounce (from perch): drops onto insects and lizards"],
    "pied-butcherbird": ["drop", "pounce (perch-return): launches at prey, returns to lookout"],
    "white-throated-kingfisher": ["drop", "pounce: drops from a wire or branch onto lizards, crabs and insects"],
    // Hangs in the wind, then drops.
    "common-kestrel": ["hover", "hover_drop: hovers with head perfectly still, then drops on a vole"],
    "american-kestrel": ["hover", "hover_drop: hovers into the wind"],
    "common-buzzard": ["hover", "hover: hangs almost motionless in the wind"],
    "barn-owl": ["hover", "hover_drop: flies silently, then strikes prey hidden under grass"],
    // Onto prey in the water.
    "osprey": ["plunge", "air_plunge: plunges feet-first into water to seize fish"],
    "brown-pelican": ["plunge", "air_plunge: plunge-dives with folded wings, scoops fish in the pouch"],
    "common-kingfisher": ["plunge", "perch_plunge: perches still above water then dives in a flash for fish"],
    "great-kiskadee": ["plunge", "hawk_insects + perch_plunge (surface fish)"],
    "white-bellied-sea-eagle": ["talon", "talon_grab: dives and snatches prey from the surface"],
    "brahminy-kite": ["talon", "talon_grab: soars over water scanning, swoops only when it spots food"],
    "buffy-fish-owl": ["talon", "talon_grab: perches low over water, drops to snatch fish from the surface"],
    "yellow-legged-gull": ["talon", "mixed_follow: snatches discarded fish astern of trawlers"],
    // The stoop (the generic aerial chase is this).
    "peregrine-falcon": ["stoop", "dive_air: stoops with folded wings"],
    "red-tailed-hawk": ["stoop", "perch+scan+dive_air: a steep stoop onto prey"],
    // In the air after flying prey.
    "slender-skimmer": ["hawk", "aerial_hawk"], "common-bluetail": ["hawk", "hawk_insects"], "common-darter": ["hawk", "hawk_insects"],
    "ruddy-darter": ["hawk", "hawk_insects"], "red-veined-darter": ["hawk", "hawk_insects"], "common-flangetail": ["hawk", "hawk_insects"],
    "barn-swallow": ["hawk", "aerial_hawk"], "european-hornet": ["hawk", "aerial_hawk"], "asian-hornet": ["hawk", "hawk_insects+hover"],
    "lesser-banded-hornet": ["hawk", "hawk_insects+hover"], "black-crested-coquette": ["hawk", "hawk_insects"], "eastern-phoebe": ["hawk", "hawk_insects"],
    "pied-fantail": ["hawk", "hawk_insects + new looping path"], "ring-billed-gull": ["hawk", "aerial_hawk: hawks swarms of mayflies and flying ants"], "kuhls-pipistrelle-bat": ["hawk", "bat_hawk"],
    // On the ground: run, stop, head tilted, the stab.
    "common-blackbird": ["peck", "worm_pull (run-stop-head-tilt)"],
    "masked-water-tyrant": ["peck", "walk (water edge) + peck"],
    "black-headed-gull": ["peck", "clip:foot_paddle: paddles on the spot to bring worms up"],
    // From the water's surface.
    "great-cormorant": ["dive", "surface_dive"], "neotropic-cormorant": ["dive", "surface_dive"], "little-black-cormorant": ["dive", "group:herding_line (dives one after another)"]
};

/** (2) An ambient hunting recipe by the species' plan (`behaviour-recipes`' plans). */
const RECIPE: Record<string, Partial<Record<string, Act>>> = {
    pounce: {quadruped: "pounce", primate: "pounce", lizard: "dash", arachnid: "dash", insect: "dash", amphibian: "lunge", flying_bird: "drop", walking_bird: "drop", flightless_bird: "drop"},
    hawk_insects: {flying_bird: "hawk", walking_bird: "peck", flying_insect: "hawk", bat: "hawk", insect: "hawk"},
    aerial_hawk: {flying_bird: "hawk", flying_insect: "hawk", bat: "hawk"},
    bat_hawk: {bat: "hawk"},
    hover_drop: {flying_bird: "hover"},
    talon_grab: {flying_bird: "talon"},
    air_plunge: {flying_bird: "plunge"},
    perch_plunge: {flying_bird: "plunge"},
    pouch_scoop: {flying_bird: "talon"},
    wade_spear: {flying_bird: "wade", walking_bird: "wade"},
    bill_sweep: {flying_bird: "wade", walking_bird: "wade"},
    surface_dive: {flying_bird: "dive", walking_bird: "dive", flightless_bird: "dive"}
};

/** (3) E5's hunt style by plan, only where nothing above says. */
const STYLE: Record<string, Partial<Record<string, Act>>> = {
    ambush: {arachnid: "lunge", insect: "lunge", amphibian: "lunge", turtle: "lunge", lizard: "lunge"},
    stalk: {quadruped: "pounce", primate: "pounce", lizard: "dash", arachnid: "dash", insect: "lunge"},
    aerial: {flying_bird: "hawk", flying_insect: "hawk", bat: "hawk", insect: "hawk"},
    trap: {arachnid: "web"},
    dive: {flying_bird: "dive", walking_bird: "dive", flightless_bird: "dive"},
    venom: {arachnid: "dash"}
};

const tactics = JSON.parse(fs.readFileSync(path.join(root, "data/ark/hunt-tactics.json"), "utf8")) as {species: Species[]};
const recipes = JSON.parse(fs.readFileSync(path.join(root, "src/ark-scene/recipes.json"), "utf8")) as {species: Record<string, string>};
const HUNT_RECIPES = new Set(Object.keys(RECIPE));
const recipesOf = (slug: string) => (recipes.species[slug] ?? "").split("|")[0].split(",").filter(Boolean).map((r) => r.slice(0, r.lastIndexOf("."))).filter((id) => HUNT_RECIPES.has(id));

type Entry = {slug: string; name: string; act: Act; basis: "catalogue" | "recipe" | "style"; because: string; field: string | null; quote: string | null};
const out: Entry[] = [];
const unknown: string[] = [];
const seen = new Set<string>();
for (const s of tactics.species) {
    seen.add(s.slug);
    const hand = HAND[s.slug];
    if (hand) {
        const row = s.rows[0];
        out.push({slug: s.slug, name: s.name, act: hand[0], basis: "catalogue", because: hand[1], field: row?.field ?? null, quote: row?.quote ?? null});
        continue;
    }
    const plan = s.plan ?? "";
    let done = false;
    for (const id of recipesOf(s.slug)) {
        const act = RECIPE[id][plan];
        if (!act) continue;
        out.push({slug: s.slug, name: s.name, act, basis: "recipe", because: `its ambient recipe ${id} (${plan})`, field: null, quote: null});
        done = true;
        break;
    }
    if (done) continue;
    const act = s.style ? STYLE[s.style.style]?.[plan] : undefined;
    if (act && s.style) out.push({slug: s.slug, name: s.name, act, basis: "style", because: `E5 style ${s.style.style} (${plan})`, field: s.style.field, quote: s.style.phrase});
}
// Species with a recipe and no row in the extract (the extract holds every species with a catalogue row or a style).
for (const [slug, row] of Object.entries(recipes.species)) {
    if (seen.has(slug)) continue;
    const ids = (row.split("|")[0] ?? "").split(",").filter(Boolean).map((r) => r.slice(0, r.lastIndexOf("."))).filter((id) => HUNT_RECIPES.has(id));
    if (ids.length) unknown.push(`${slug}: ${ids.join(",")}`);
}
for (const slug of Object.keys(HAND)) if (!tactics.species.some((s) => s.slug === slug)) unknown.push(`${slug}: in HAND, no row in the extract`);
out.sort((a, b) => a.slug.localeCompare(b.slug));

if (unknown.length) console.log(`recipes-only species (no catalogue row or style; need their plan from the recipes table):\n  ${unknown.slice(0, 40).join("\n  ")}`);

// The species with an ambient hunting recipe and no row at all: by the recipes table's own plan.
const plans = new Map((JSON.parse(fs.readFileSync(path.join(root, "data/ark/behaviour-recipes.json"), "utf8")) as {species: Array<{slug: string; name: string; plan: string}>}).species.map((s) => [s.slug, s]));
for (const line of unknown) {
    const [slug] = line.split(":");
    const sp = plans.get(slug);
    if (!sp || out.some((e) => e.slug === slug)) continue;
    for (const id of recipesOf(slug)) {
        const act = RECIPE[id][sp.plan];
        if (!act) continue;
        out.push({slug, name: sp.name, act, basis: "recipe", because: `its ambient recipe ${id} (${sp.plan})`, field: null, quote: null});
        break;
    }
}
out.sort((a, b) => a.slug.localeCompare(b.slug));

const compact = {
    about: "Generated by scripts/ark-hunt-acts.mts (full rows with their basis: data/ark/hunt-acts.json). One hunt act per species; absent = the generic chase. Read by hunt-acts.ts.",
    version: "hunt-acts-v1",
    species: Object.fromEntries(out.map((e) => [e.slug, e.act]))
};
const full = {about: "Each species' hunt act and what it follows: a catalogue row (the species' own text), its ambient hunting recipe, or E5's hunt style. Generated by scripts/ark-hunt-acts.mts.", version: "hunt-acts-v1", acts: out};

if (!process.argv.includes("--dry")) {
    fs.writeFileSync(path.join(root, "src/ark-scene/hunt-acts.json"), `${JSON.stringify(compact)}\n`);
    fs.writeFileSync(path.join(root, "data/ark/hunt-acts.json"), `${JSON.stringify(full, null, 0).replace(/\{"slug"/g, "\n{\"slug\"")}\n`);
}

if (process.argv.includes("--summary") || process.argv.includes("--aboard")) {
    const by = new Map<string, number>();
    for (const e of out) by.set(e.act, (by.get(e.act) ?? 0) + 1);
    console.log(`species with a hunt act: ${out.length}`, Object.fromEntries([...by].sort((a, b) => b[1] - a[1])));
    const basis = new Map<string, number>();
    for (const e of out) basis.set(e.basis, (basis.get(e.basis) ?? 0) + 1);
    console.log("by basis:", Object.fromEntries(basis));
    const aboardPath = arg("aboard");
    if (aboardPath) {
        const aboard = fs.readFileSync(aboardPath, "utf8").split("\n").filter((l) => l.startsWith("{")).map((l) => JSON.parse(l) as {slug: string; n: number; island: string});
        const acts = new Map(out.map((e) => [e.slug, e.act]));
        const rows = new Map<string, {n: number; islands: Set<string>}>();
        for (const a of aboard) {
            const r = rows.get(a.slug) ?? rows.set(a.slug, {n: 0, islands: new Set()}).get(a.slug)!;
            r.n += a.n;
            r.islands.add(a.island);
        }
        let species = 0;
        let animals = 0;
        const perAct = new Map<string, {species: number; animals: number}>();
        for (const [slug, r] of rows) {
            const act = acts.get(slug);
            if (!act) continue;
            species++;
            animals += r.n;
            const p = perAct.get(act) ?? perAct.set(act, {species: 0, animals: 0}).get(act)!;
            p.species++;
            p.animals += r.n;
        }
        console.log(`aboard now: ${species} of ${rows.size} species, ${animals} of ${[...rows.values()].reduce((s, r) => s + r.n, 0)} animals`, Object.fromEntries([...perAct].sort((a, b) => b[1].animals - a[1].animals)));
    }
}
