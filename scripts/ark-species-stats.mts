#!/usr/bin/env -S npx tsx
/**
 * `src/ark-scene/species-stats.json`: every species that can come aboard
 * (`voyage_species`), its five stats from `species_profiles.canonical_game_stats`
 * and, where the catalogue stores one, a body length in metres.
 *
 * The data comes from a read-only query of the live catalogue, run from
 * the AnimalDex repo:
 *
 *   supabase db query --linked -o json "select vs.model_slug as slug,
 *     sp.canonical_game_stats as stats,
 *     sp.generation_metadata->>'stats_basis' as basis
 *     from voyage_species vs join species_profiles sp on sp.id = vs.species_profile_id
 *     order by vs.model_slug" > catalogue-stats.json
 *
 *   npx tsx scripts/ark-species-stats.mts catalogue-stats.json
 *
 * The stored length: only the size clause of `stats_basis` ("size 27->14:
 * 25-35 cm body ..."), its first length (a range's middle) that isn't a
 * wingspan, a height or a shoulder; kept only when it agrees with the size
 * stat within a factor of four (else it is most likely a misread). The
 * Ark's traits lane will store these properly (`voyage_species_traits`
 * `length_m`); the snapshot's own value wins over this file.
 *
 * Rows: [size, speed, dominance, rarity, intelligence] or the same plus length_m.
 */
import {readFileSync, writeFileSync} from "node:fs";
import {dirname, join, resolve} from "node:path";
import {fileURLToPath} from "node:url";
import {lengthFromMass, massFromSize} from "../src/ark-scene/stats.ts";

const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const input = process.argv[2];
if (!input) throw new Error("usage: ark-species-stats.mts <query output json>");
const raw = JSON.parse(readFileSync(input, "utf8")) as {rows: Array<{slug: string; stats: Record<string, unknown> | null; basis: string | null}>};

const KEYS = ["size", "speed", "dominance", "rarity", "intelligence"] as const;
const NUMBER = String.raw`(\d+(?:\.\d+)?)`;
const LENGTH = new RegExp(String.raw`(?:about\s+|~|c\.\s*|up to\s+)?` + NUMBER + String.raw`(?:\s*(?:-|–|to)\s*` + NUMBER + String.raw`)?\s*(mm|cm|m)\b(?!\s*(?:wingspan|wing|tall|high|at the shoulder|shoulder|height|across|span|in diameter|diameter|deep))`, "i");
const UNIT: Record<string, number> = {mm: 0.001, cm: 0.01, m: 1};

function storedLength(basis: string | null, size: number): number | null {
    const clause = (basis ?? "").split("|").map((part) => part.trim()).find((part) => /^size\b/i.test(part));
    if (!clause) return null;
    const text = clause.replace(/^size\s*\d+\s*(?:->|→)\s*\d+\s*:\s*/i, "");
    const match = LENGTH.exec(text);
    if (!match) return null;
    const before = text.slice(Math.max(0, match.index - 14), match.index).toLowerCase();
    if (/wingspan|span|tall|height|shoulder/.test(before)) return null;
    const low = Number(match[1]);
    const high = match[2] ? Number(match[2]) : low;
    const metres = (low + high) / 2 * UNIT[match[3].toLowerCase()];
    const ratio = metres / lengthFromMass(massFromSize(size));
    return ratio >= 0.25 && ratio <= 4 ? Math.round(metres * 1000) / 1000 : null;
}

const species: Record<string, number[]> = {};
let lengths = 0;
for (const row of raw.rows.sort((a, b) => a.slug.localeCompare(b.slug))) {
    const stats = row.stats ?? {};
    const values = KEYS.map((key) => Number(stats[key]));
    if (values.some((v) => !Number.isFinite(v))) continue;
    const length = storedLength(row.basis, values[0]);
    if (length !== null) lengths++;
    species[row.slug] = length !== null ? [...values, length] : values;
}

const out = join(root, "src/ark-scene/species-stats.json");
writeFileSync(out, JSON.stringify({
    about: "Generated by scripts/ark-species-stats.mts from the live catalogue. Rows: [size, speed, dominance, rarity, intelligence] or the same plus a stored length in metres.",
    species
}).replace(/\],"/g, "],\n\"") + "\n");
console.log(`${Object.keys(species).length} species, ${lengths} with a stored length -> ${out}`);
