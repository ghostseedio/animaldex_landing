#!/usr/bin/env -S npx tsx
/**
 * The safari's resident table (p4 (safari), `src/ark-scene/islands/town/safari.ts` safariHabitatOf): for every catalogue
 * species, from its stored profile (`data/ark/behaviour-profiles.json`: zone, diet, body plan, size, each with the
 * stored phrase that decided it), which safari habitat it would live in if the zoo holds it in the savanna paddocks
 * (herbivores) or the reptile house (crocodilians). The predators go by binomial in `safari.ts`. Rule, no lists:
 *
 * - herbivores: a quadruped (the hoofed and the heavy mammals; the flightless birds keep the zoo's paddocks, theirs now
 *   alone), body size ≥ 45, diet not meat or fish; by zone: grassland → plains, desert → desert, rainforest or
 *   woodland → forest (edge), wetland or river_lake → wetland (the hippo pool);
 * - the river: a "lizard" body plan (the crocodilians' rig) of wetland or river_lake, size ≥ 55, eating fish or meat.
 *
 *   npx tsx scripts/ark-safari-residents.mts            writes src/ark-scene/islands/town/safari-residents.json
 */
import {readFileSync, writeFileSync} from "node:fs";
import path from "node:path";
import {fileURLToPath} from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
type Profile = {slug: string; zone: string; plan: string; diet: string; size: number};
const profiles = (JSON.parse(readFileSync(path.join(root, "data/ark/behaviour-profiles.json"), "utf8")) as {profiles: Profile[]}).profiles;
const ZONE: Record<string, string> = {grassland: "plains", desert: "desert", rainforest: "forest", woodland: "forest", wetland: "wetland", river_lake: "wetland"};
const habitats: Record<string, string> = {};
const why: Record<string, string> = {};
for (const p of profiles) {
    let habitat: string | null = null;
    if (p.plan === "quadruped" && p.size >= 45 && p.diet !== "meat" && p.diet !== "fish") habitat = ZONE[p.zone] ?? null;
    else if (p.plan === "lizard" && p.size >= 55 && (p.zone === "wetland" || p.zone === "river_lake") && (p.diet === "fish" || p.diet === "meat")) habitat = "river";
    if (!habitat) continue;
    habitats[p.slug] = habitat;
    why[p.slug] = `${p.zone} ${p.plan} ${p.diet} ${p.size}`;
}
const out = {
    about: "Generated by scripts/ark-safari-residents.mts from data/ark/behaviour-profiles.json (stored zone, diet, body plan, size). Which safari habitat a species lives in when the zoo holds it in the savanna paddocks (herbivores) or the reptile house (the river); the town applies it only from those enclosures (safari.ts safariHabitatOf).",
    habitats,
    why
};
writeFileSync(path.join(root, "src/ark-scene/islands/town/safari-residents.json"), JSON.stringify(out) + "\n");
console.log(Object.keys(habitats).length, "species");
