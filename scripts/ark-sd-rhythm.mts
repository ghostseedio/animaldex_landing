#!/usr/bin/env -S npx tsx
/**
 * Each Ark species' System Dynamics rhythm (lane `ark-sd-align`, 2026-11-15; `src/lib/ark-sd-rhythm.ts`): what its SD
 * frequency profile's modes are about, in the Ark's six kinds, and its tempo, read by rule from the stored modes (no
 * AI, no hand-set species). Written to `src/ark-scene/sd-rhythm.json`, which the schedule reads (`ark-scene/sd-rhythm.ts`).
 *
 * Input (read-only), run from the AnimalDex repo:
 *   supabase db query --linked -o json "select vs.model_slug slug, vs.species_profile_id id, sp.landing_page_slug page,
 *     sd.frequency_profile from voyage_species vs join species_system_dynamics sd on sd.species_profile_id=vs.species_profile_id
 *     join species_profiles sp on sp.id=vs.species_profile_id where vs.excluded_reason is null and vs.model_slug is not null
 *     order by vs.model_slug" > sd-export.json
 *
 *   npx tsx scripts/ark-sd-rhythm.mts sd-export.json [--days src/app/api/ark/sd-day/days.json [--ordinary ordinary-audit.json]]
 *
 * A row: `level|kinds|page`: its tempo on the 0 (LOW) … 2 (HIGH) line; each kind's share of its modes in hundredths
 * (`feed:60,still:40`); its species page's slug (the card's "How it lives" link).
 */
import fs from "node:fs";
import path from "node:path";
import {sdRhythmOf, type SdCategory} from "../src/lib/ark-sd-rhythm.ts";

const input = process.argv[2];
if (!input) throw new Error("usage: ark-sd-rhythm.mts sd-export.json");
const raw = JSON.parse(fs.readFileSync(input, "utf8"));
const rows: Array<{slug: string; id?: string; page: string | null; frequency_profile: {modes?: unknown[]} | null}> = Array.isArray(raw) ? raw : raw.rows;
const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..");
const species: Record<string, string> = {};
let none = 0;
for (const row of rows) {
    if (!row.slug || species[row.slug]) continue;
    const rhythm = sdRhythmOf((row.frequency_profile?.modes ?? []) as never);
    if (!rhythm) {
        none++;
        continue;
    }
    const kinds = (Object.entries(rhythm.target) as Array<[SdCategory, number]>).filter(([, v]) => v > 0.004).sort((a, b) => b[1] - a[1]).map(([k, v]) => `${k}:${Math.round(v * 100)}`).join(",");
    species[row.slug] = `${rhythm.level.toFixed(2)}|${kinds}|${row.page ?? ""}`;
}
const out = {about: "Generated by scripts/ark-sd-rhythm.mts from species_system_dynamics.frequency_profile (src/lib/ark-sd-rhythm.ts rules). Row: tempo level 0 LOW..2 HIGH|kind:hundredths of the modes,...|species page slug.", species: Object.fromEntries(Object.entries(species).sort(([a], [b]) => a.localeCompare(b)))};
fs.writeFileSync(path.join(root, "src/ark-scene/sd-rhythm.json"), JSON.stringify(out));
console.log(`${Object.keys(species).length} species with a rhythm, ${none} whose modes say nothing the Ark shows`);

// `--days <days.json>`: the audit's sample days (`ark-sd-alignment.mts --days-out`, by model slug) keyed by the species
// profile id the species page asks with, in place.
const daysAt = process.argv.indexOf("--days");
if (daysAt > 0) {
    const file = process.argv[daysAt + 1];
    const days = JSON.parse(fs.readFileSync(file, "utf8"));
    const idOf = new Map<string, string>();
    for (const row of rows as Array<{slug: string; id?: string}>) if (row.slug && row.id && !idOf.has(row.slug)) idOf.set(row.slug, row.id.toLowerCase());
    // (`--ordinary <audit.json>`: the same kinds' day not kept by steps, `ark-sd-alignment.mts --thrive ordinary --json`,
    // for the home page's loop: ordinary → a step that works → prime.)
    const ordinaryAt = process.argv.indexOf("--ordinary");
    const ordinary = new Map<string, {line: number[]; state: string; score: number}>();
    if (ordinaryAt > 0) for (const r of JSON.parse(fs.readFileSync(process.argv[ordinaryAt + 1], "utf8")).rows as Array<{slug: string; hourly: number[]; state: string; score: number}>) ordinary.set(r.slug, {line: r.hourly, state: r.state, score: Math.round(r.score * 1000) / 1000});
    const keyed: Record<string, unknown> = {};
    for (const [key, day] of Object.entries(days.species as Record<string, {slug: string; ordinary?: unknown}>)) {
        const id = idOf.get(day.slug) ?? (/^[0-9a-f-]{36}$/i.test(key) ? key : null);
        if (ordinary.has(day.slug)) day.ordinary = ordinary.get(day.slug);
        if (id) keyed[id] = day;
    }
    fs.writeFileSync(file, JSON.stringify({...days, species: keyed}));
    console.log(`${Object.keys(keyed).length} sample days keyed by species profile id`);
}
