#!/usr/bin/env -S npx tsx
/**
 * Group life, wave 1 (lane SIG-GROUP; AnimalDex docs/ark/behaviours-plan.md P5): turns `data/ark/group-behaviours.json`
 * (the catalogue's "group life" rows, each with its stored sentence and the act the 3D scene plays for it) into what the
 * scene reads:
 *
 *   src/ark-scene/group-acts.json      species → its group acts (`behaviour-group.ts`) and the species that live in groups
 *   src/ark-scene/group-recipes.json   species → existing recipes the species lacked (merged by `speciesRecipes`)
 *   src/ark-scene/group-lines.json     species → recipe → the species' own sentence for it, said in the live log
 *
 * Guards: every species is one the scene has a profile for; every row keeps a stored field and a non-empty sentence;
 * every act is one the engine knows; a recipe is added only where the template is drawn for the species' body plan.
 *
 *   npx tsx scripts/ark-group-behaviours.mts [--check]
 */
import fs from "node:fs";
import path from "node:path";

const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..");
const check = process.argv.includes("--check");
type Row = {slug: string; name: string; field: string; quote: string; line: string | null; acts: string[]; status: "built" | "partial" | "existing" | "held" | "recipe"; why: string | null};
const data = JSON.parse(fs.readFileSync(path.join(root, "data/ark/group-behaviours.json"), "utf8")) as {lives: string[]; recipes: Record<string, string[]>; rows: Row[]};
const profiles = new Set((JSON.parse(fs.readFileSync(path.join(root, "data/ark/behaviour-profiles.json"), "utf8")) as {profiles: Array<{slug: string}>}).profiles.map((p) => p.slug));
const TEMPLATES = new Set(["allogroom", "v_formation", "bat_emergence", "mixed_follow", "swarm", "swarm_dusk", "cluster"]);
const ACTS = new Set(["huddle", "sentinel", "gather", "lick", "chorus", "feast", "basking", "commute", "pairs", "roost"]);
/** The recipe each act plays (those that play one: the schedule's trip carries it, the log says its sentence). */
const PLAYS: Record<string, string> = {huddle: "huddle", sentinel: "sentinel_post", gather: "dusk_gather", lick: "lick_gather", chorus: "chorus", feast: "tree_feast", basking: "bask_pile"};
/** The order the engine tries a species' acts in (the specific before the general). */
const ORDER = ["sentinel", "lick", "chorus", "feast", "basking", "huddle", "gather", "commute", "pairs", "roost"];

const problems: string[] = [];
const species: Record<string, Set<string>> = {};
const lines: Record<string, Record<string, string>> = {};
for (const row of data.rows) {
    if (!profiles.has(row.slug)) problems.push(`${row.slug}: no profile`);
    if (!row.field || !row.quote) problems.push(`${row.slug}: no stored sentence`);
    if (row.status === "held" && !row.why) problems.push(`${row.slug}: held without a reason`);
    if (row.status !== "built" && row.status !== "partial") continue;
    for (const act of row.acts) {
        if (act.startsWith("recipe:")) continue;
        const id = act.split(":")[0];
        if (!ACTS.has(id)) problems.push(`${row.slug}: unknown act ${act}`);
        (species[row.slug] ??= new Set()).add(act);
        if (row.line && PLAYS[id]) (lines[row.slug] ??= {})[PLAYS[id]] = row.line;
    }
}
for (const slug of data.lives) if (!profiles.has(slug)) problems.push(`${slug}: lives, no profile`);
for (const [slug, list] of Object.entries(data.recipes)) {
    if (!profiles.has(slug)) problems.push(`${slug}: recipe, no profile`);
    for (const r of list) if (!TEMPLATES.has(r.split(".")[0])) problems.push(`${slug}: unknown recipe ${r}`);
}
if (problems.length) {
    console.error(problems.join("\n"));
    process.exit(1);
}
const rank = (token: string) => ORDER.indexOf(token.split(":")[0]);
const acts = Object.fromEntries(
    Object.entries(species)
        .sort(([a], [b]) => a.localeCompare(b))
        .map(([slug, set]) => [slug, [...set].sort((a, b) => rank(a) - rank(b) || a.localeCompare(b)).join(" ")])
);
const write = (file: string, value: unknown) => {
    const text = `${JSON.stringify(value)}\n`;
    const at = path.join(root, file);
    if (check) {
        if (!fs.existsSync(at) || fs.readFileSync(at, "utf8") !== text) {
            console.error(`${file} is out of date: run scripts/ark-group-behaviours.mts`);
            process.exitCode = 1;
        }
        return;
    }
    fs.writeFileSync(at, text);
};
write("src/ark-scene/group-acts.json", {about: "Generated by scripts/ark-group-behaviours.mts from data/ark/group-behaviours.json (lane SIG-GROUP): species -> group acts, tried in order (behaviour-group.ts); lives: species grouped round a leader though their profile says otherwise.", version: "group-acts-1", lives: [...data.lives].sort(), species: acts});
write("src/ark-scene/group-recipes.json", {about: "Generated by scripts/ark-group-behaviours.mts: existing recipes (id.weight) a species lacked, from its group-life row (data/ark/group-behaviours.json); merged by speciesRecipes.", version: "group-recipes-1", species: Object.fromEntries(Object.entries(data.recipes).sort(([a], [b]) => a.localeCompare(b)).map(([slug, list]) => [slug, list.join(",")]))});
write("src/ark-scene/group-lines.json", {about: "Generated by scripts/ark-group-behaviours.mts: a species' own sentence for what a group act shows (data/ark/group-behaviours.json), said in the live log in place of the generic line (live/signature-lines.ts).", version: "group-lines-1", species: lines});
const tally = data.rows.reduce<Record<string, number>>((m, r) => ((m[r.status] = (m[r.status] ?? 0) + 1), m), {});
console.log(JSON.stringify({rows: data.rows.length, ...tally, species: Object.keys(acts).length, lives: data.lives.length, recipes: Object.keys(data.recipes).length, lines: Object.keys(lines).length}));
