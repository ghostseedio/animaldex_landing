NEXT_PUBLIC_SITE_URL=https://animaldex.app
SITE_URL=https://animaldex.app
NEXT_PUBLIC_APP_URL=https://animaldex.app
CANONICAL_URL=https://animaldex.app

# Verified links (required before Universal Links/App Links activate)
# Apple value can be supplied directly as TEAM_ID.BUNDLE_ID, or as the two parts below.
APPLE_APPLICATION_IDENTIFIER=U87CQY25JC.com.lennybeadle.animaldexios
APPLE_TEAM_ID=U87CQY25JC
APPLE_BUNDLE_ID=com.lennybeadle.animaldexios
ANDROID_APP_PACKAGE=app.animaldex
# Comma-separated release signing certificate fingerprints.
ANDROID_SHA256_CERT_FINGERPRINTS=

# Google Analytics 4 (optional — leave blank to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Set to true only after production Instagram OAuth smoke-test on animaldex.app.
# Until then, do not advertise web-first / no-app-download import as live.
# Parsing is explicit: only the string "true" is live. Absent, "false", and "1" are off.
# Next.js inlines NEXT_PUBLIC_* at build time — set this on the Vercel Production
# environment, then rebuild. Do not use Boolean(process.env....).
# NEXT_PUBLIC_INSTAGRAM_WEB_IMPORT_LIVE=true

# Paddle Billing web store (LIVE). Never put sandbox IDs on animaldex.app.
# PADDLE_API_KEY and PADDLE_WEBHOOK_SECRET are server-only.
PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_CREDITS_25=
PADDLE_PRICE_CREDITS_100=
PADDLE_PRICE_PRO_MONTHLY=


# Support inbox (Vercel production)
SUPABASE_URL=
# JWT anon/public key from Supabase Dashboard → Project Settings → API (starts with eyJ...)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only needed for direct browser Supabase usage
NEXT_PUBLIC_SUPABASE_URL=https://wwhsdzpczekgdlobwaej.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind3aHNkenBjemVrZ2Rsb2J3YWVqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzUxMzYyNzksImV4cCI6MjA5MDcxMjI3OX0.kUvtAQM8t9VbLH_avZcjOAg1_N36M-kG5080FOnTNV0
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SUPPORT_ADMIN_PASSWORD=
SUPPORT_ADMIN_SESSION_SECRET=

# Shared secret for /admin/notifications. Must be byte-identical to the
# ADMIN_NOTIFICATION_TOKEN secret on the Supabase project, which the
# send-admin-notification edge function compares it against - if they differ the
# function returns 403 and the panel reports the send as failed. Rotating means
# setting both sides; setting one alone breaks sending.
ADMIN_NOTIFICATION_TOKEN=
SUPPORT_FORWARD_TO=
SUPPORT_FROM_EMAIL=support@animaldex.app
SUPPORT_WEBHOOK_URL=https://animaldex.app/api/resend/inbound

# Wise Platform (Phase 7B sandbox only — never commit real tokens)
# WISE_ENVIRONMENT=sandbox
# WISE_API_TOKEN=
# WISE_PROFILE_ID=
# WISE_BALANCE_ID=
# WISE_WEBHOOK_PUBLIC_KEY=
# WISE_LEGAL_ENTITY_NAME=Ghostseed Ltd
# Production Wise (Ghostseed Ltd) — IDs only; token never committed
# WISE_PRODUCTION_API_TOKEN=
# WISE_PRODUCTION_PROFILE_ID=
# WISE_PRODUCTION_BALANCE_ID=

# Local dev performance tracing. In development, steps slower than 250ms and
# requests slower than 1s log automatically. Set ANIMALDEX_DEBUG_PERF=1 for
# full step-by-step traces in the terminal.
# ANIMALDEX_DEBUG_PERF=1
# ANIMALDEX_TRACE_REQUESTS=1
