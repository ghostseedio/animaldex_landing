      "static/chunks/app/[locale]/(composited)/layout.js"
    ],
    "/[locale]/(composited)/animals/[slug]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/(composited)/animals/[slug]/page.js"
    ],
    "/[locale]/layout": [
