[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/assetlinks/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/auth/login/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/auth/logout/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/auth/oauth/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/auth/session/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/capture-images/[captureId]/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/capture-media/[captureId]/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/comparisons/animals/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/comparisons/comments/report/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/comparisons/comments/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/comparisons/generate/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/comparisons/vote/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/debug-public-profile/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/resend/inbound/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/species-images/[slug]/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/species-subtitles/[slug]/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/support/reply/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/api/support/thread/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/auth/callback/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/blog/feed.xml/route.ts",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/legal/layout.tsx",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/legal/legal-page.tsx",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/legal/privacy/page.tsx",[],[],"/Users/lennybeadle/AnimalDex-landing/src/app/legal/terms/page.tsx",[],[],"/Users/lennybeadle/AnimalDex-lan