# VCS / CI (workflow is not needed inside the image build context)
.git
.github
.gitattributes

# Dependencies & build output (rebuilt in the image)
node_modules
.next
.next-*
out
build
coverage
*.tsbuildinfo

# Env / secrets — never enter the build context
.env
.env.*
!.env.example

# Alternate lockfile / install noise (image uses npm ci + package-lock.json)
yarn.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnp
.pnp.js

# IDE / OS
.idea
.vscode
.fleet
.cursor
.DS_Store
*.pem
*.swp
*~

# Local / temp junk not required for `next build`
.native-range-build
.vercel
supabase
blog-content-temp
docs
CONTENT-DIFF-MATRIX.md
SEO-IDENTIFICATION-AUDIT.md
SEO-IDENTIFICATION-AUDIT-TABLE.md

# Unit tests are not required to compile the app
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
